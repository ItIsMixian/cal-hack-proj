{
  "name": "mirrorville",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
    "publish:local": "spacetime publish mirrorville --module-path spacetimedb --server local --yes",
    "set-keys": "node scripts/set-keys.mjs",
    "check-decisions": "node scripts/check-decisions.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "spacetimedb": "2.13.*"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.6.2",
    "vite": "^7.1.5"
  }
}
