{
  "name": "mirrorville",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode worldtest --host 127.0.0.1 --port 5173 --strictPort",
    "dev:worlds": "vite --mode worldtest --host 127.0.0.1 --port 5173 --strictPort",
    "build:worlds": "tsc -b && vite build --mode worldtest",
    "setup:worlds": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-local-worlds.ps1",
    "test:worlds:live": "node scripts/test-worlds-live.mjs",
    "test:public-towns:live": "node scripts/test-public-towns-live.mjs",
    "build": "tsc -b && vite build --mode worldtest",
    "preview": "vite preview",
    "generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
    "publish:local": "npm run setup:worlds",
    "set-keys": "node scripts/set-keys.mjs",
    "test:diary": "node --test scripts/test-diary.mjs scripts/test-diary-comments.mjs scripts/test-diary-window.mjs",
    "test:status-card": "node --test scripts/test-resident-status.mjs",
    "test:roaming": "node --test scripts/test-roaming.mjs",
    "test:importers": "node --test scripts/test-importers.mjs",
    "test:facebook": "node --test scripts/test-facebook.mjs",
    "test:sources": "node --test scripts/test-source-offering.mjs scripts/test-github.mjs scripts/test-marglo-package.mjs scripts/test-desktop-observer.mjs",
    "test:marglo-exporter": "python scripts/test-marglo-exporter.py",
    "marglo:export": "python scripts/export-marglo-package.py",
    "desktop:observe": "python desktop/observer.py",
    "test:desktop": "node --test scripts/test-desktop-observer.mjs",
    "test:desktop-native": "python desktop/test_observer.py",
    "test:mobile-share": "node --test scripts/test-mobile-share.mjs",
    "test:learning": "node --test scripts/test-learning.mjs",
    "test:fidelity": "node --test scripts/test-fidelity.mjs",
    "test:auth": "node --test scripts/test-auth-session.mjs",
    "check-decisions": "node scripts/check-decisions.mjs",
    "desktop:ui": "node scripts/build-desktop.mjs",
    "desktop:helper": "python scripts/build-desktop-helper.py",
    "desktop:dev": "npm run desktop:ui && electron .",
    "desktop:pack": "npm run desktop:ui && npm run desktop:helper && electron-builder --config desktop/electron-builder.json --win --x64",
    "test:desktop-app": "node --test scripts/test-desktop-app.mjs"
  },
  "dependencies": {
    "compromise": "^14.19.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-oidc-context": "^3.3.1",
    "spacetimedb": "2.13.*"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^5.0.2",
    "typescript": "~5.6.2",
    "vite": "^7.1.5",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "main": "desktop/app/main.mjs",
  "description": "Mirrorville desktop with private, opt-in local observation",
  "author": "Mirrorville team"
}
