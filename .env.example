# Where the browser connects to SpacetimeDB.
VITE_SPACETIMEDB_HOST=ws://localhost:3000
VITE_SPACETIMEDB_DB_NAME=mirrorville

# Public OAuth client ID from the database's SpacetimeAuth dashboard.
# Allow http://localhost:5173/callback and http://127.0.0.1:5173/callback.
# Allow both origins as post-logout redirect URIs. No client secret in a SPA.
VITE_SPACETIMEAUTH_CLIENT_ID=
VITE_SPACETIMEAUTH_AUTHORITY=https://auth.spacetimedb.com/oidc
# Optional: defaults to the current browser origin + /callback.
# VITE_SPACETIMEAUTH_REDIRECT_URI=http://localhost:5173/callback

# Model keys, read by `npm run set-keys`. Never commit them.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
